main () {
  const N = 10;
  const BASE = 16;
  
  int i = 0;
  int sum = 0;
  int expected_sum = N * (N+1) / 2;

  while (i - N) {
    const foo;
    i = i + 1;
    *(i + BASE) = i;
  }

  i = 0;
  while (i - N) {
    const bar;
    i = i + 1;
    sum = sum + *(i + BASE);
  }

  printf(sum);
  printf(expected_sum);
}
